# Forma (formacursor) — variables d'environnement
# Copier en .env.local (ignoré par git) et remplir si besoin.

# ── Supabase (optionnel — sync cloud future, non branché en 0.25.x) ──
# Créer un projet sur https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── App URL (optionnel — redirections OAuth Supabase) ──
# Dev local :
VITE_APP_URL=http://localhost:5173
# Preview / production (exemple) :
# VITE_APP_URL=https://formacursor.vercel.app

# Notes :
# - Toutes ces variables sont OPTIONNELLES pour l'app offline actuelle.
# - Sans Supabase, Forma fonctionne entièrement en local (IndexedDB).
# - Ne jamais committer .env.local ni de clés secrètes service_role.
