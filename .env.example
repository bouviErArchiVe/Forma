# FORMA — Variables d'environnement
# Copie ce fichier en .env.local et remplis tes valeurs

# Supabase (gratuit sur supabase.com)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# App URL (pour les redirections OAuth)
VITE_APP_URL=http://localhost:5173

# FormaCloud — Google Drive (optionnel)
# Console Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Origines autorisées : http://localhost:5173 et votre domaine Vercel
# Activer l'API Google Drive
# VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# FormaDico — dictionnaire (optionnel, API personnalisée)
# VITE_DICO_API_URL=https://your-dico-api.example/lookup

# Traduction (optionnel)
# Provider: browser (défaut, en ligne) | api | mock (démo limitée)
# VITE_TRANSLATE_PROVIDER=browser
# VITE_TRANSLATE_API_URL=https://your-translate-api.example/translate
# VITE_LIBRETRANSLATE_URL=https://libretranslate.com/translate

# FormaAI (optionnel — mode local sans API)
# VITE_AI_PROVIDER=mock | api
# VITE_AI_API_URL=https://your-ai-api.example/completion
# VITE_AI_API_KEY=your_key
# VITE_AI_MODEL=gpt-4o-mini
